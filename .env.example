NODE_ENV=development
PORT=10000
SITE_URL=http://localhost:10000
APP_NAME=Aki Dev

# Optional dedicated key for AES-256-GCM encryption of OAuth session tokens.
# Generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=

# Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: register slash commands instantly in one server during testing
DISCORD_GUILD_ID=
# Optional: configure the account that can use the +legit shortcut
LEGIT_TARGET_USER_ID=
# Every N warnings, attempt a bot timeout if the target is moderatable (0 disables escalation).
WARN_ESCALATION_THRESHOLD=3
WARN_ESCALATION_MINUTES=10

# Google Cloud OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Render Postgres / local Postgres
DATABASE_URL=
# auto (default), disable, require, or verify-full. Render internal Postgres uses auto/no TLS.
PGSSL_MODE=auto
# Optional legacy override: true or false. Leave empty to use PGSSL_MODE policy.
PGSSL_REJECT_UNAUTHORIZED=

# Shared 1.2 second cooldown per user/server/command; set 0 to disable.
COMMAND_COOLDOWN_MS=1200
BOT_PRESENCE_TEXT=Aki Dev · /help
BOT_PRESENCE_TYPE=Watching
BOT_PRESENCE_STATUS=online
